<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.mycompany.oopproject.PrimaryController">
    <children>
        <Label text="How much would you like to deposit?" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
        
        <!-- Input field where users type the amount -->
        <TextField fx:id="amountField" promptText="Enter deposit amount" maxWidth="300.0" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #666;" />
        
        <!-- Status label for success or error text alerts -->
        <Label fx:id="depositMessageLabel" style="-fx-text-fill: #ff6b6b;" />
        
        <!-- Action button to run the calculation -->
        <Button text="Confirm Deposit" onAction="#handleDepositSubmit" style="-fx-background-color: #2ebd59; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        
        <!-- Return route button back to panel view -->
        <Button text="Back to Dashboard" onAction="#handleDashboardView" style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand;" />
    </children>
</VBox>
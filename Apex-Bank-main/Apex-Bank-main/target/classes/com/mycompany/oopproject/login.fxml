<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.mycompany.oopproject.LoginController" prefHeight="600.0" prefWidth="900.0">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    
    <Label text="Apex Bank Login" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
    
    <VBox spacing="5.0" maxWidth="300.0">
        <Label text="Username/Account Number" style="-fx-text-fill: #b3b3b3;" />
        <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #666;" />
    </VBox>
    
    <VBox spacing="5.0" maxWidth="300.0">
        <Label text="Password" style="-fx-text-fill: #b3b3b3;" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #666;" />
    </VBox>
    
    <Label fx:id="messageLabel" style="-fx-text-fill: #ff6b6b;" />
    
    <HBox spacing="10.0" alignment="CENTER">
        <Button text="Login" onAction="#handleLogin" prefWidth="100.0" style="-fx-background-color: #2ebd59; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button text="Register" onAction="#handleRegister" prefWidth="100.0" style="-fx-background-color: #444; -fx-text-fill: white; -fx-cursor: hand;" />
    </HBox>
</VBox>